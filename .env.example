# Пример имён production-переменных. Файл не загружает значения в Django.
# Настоящие значения задавайте в окружении или в панели облачной платформы.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
